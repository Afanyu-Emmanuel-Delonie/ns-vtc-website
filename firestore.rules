rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Jobs: public read (powers /careers, /careers/[slug]),
    // writes restricted to signed-in admins (src/app/admin/jobs).
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.title is string
        && request.resource.data.department is string
        && request.resource.data.archived == false;
      allow update, delete: if isSignedIn();
    }

    // Contacts: anyone can submit via the homepage contact form,
    // only signed-in admins can read/manage them.
    match /contacts/{contactId} {
      allow create: if request.resource.data.fullName is string
        && request.resource.data.phone is string;
      allow read, update, delete: if isSignedIn();
    }

    // Applications: anyone can submit via the public /register form,
    // but only signed-in admins can read/manage them (src/app/admin/applications).
    match /applications/{applicationId} {
      allow create: if request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.phone is string
        && request.resource.data.course is string;
      allow read, update, delete: if isSignedIn();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
